{#
  A document an invoicing module issued late (block R, R18), to the customer,
  in the language of the order: the module failed or was missing when the
  order's mail went out, and the retry had it issued. The document is
  attached; the mail is not sent without it.

  Loaded as @Contao/mail/consho_document_issued.html.twig. Parameters are a
  LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order         the order in InvoiceView's shape
    customer      {name, email}
    document      {type: invoice, cancellation or creditNote, number}
    viewUrl       the order page, with a token
#}
{% block subject %}{{ ('CONSHO.mail.documentIssued.subject.' ~ document.type)|trans([document.number, order.orderNumber], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ ('CONSHO.mail.documentIssued.intro.' ~ document.type)|trans([document.number, order.orderNumber], 'contao_default') }}</p>

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
