{#
  Confirmation of receipt of a withdrawal (D-2, § 356a Abs. 3 BGB, § 13a FAGG,
  Art. 11a Directive 2011/83/EU), to the customer, in the language of the
  order. The law wants it "without undue delay", on a durable medium, with
  the CONTENT of the declaration and the DATE AND TIME of receipt — the mail
  therefore repeats the declaration in full, and receivedAt carries both.

  No judgement in here: whether the withdrawal was in time is the operator's
  to decide (D-3). This mail confirms that it arrived, nothing more.

  Loaded as @Contao/mail/consho_withdrawal_received.html.twig. Parameters
  are a LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order       the order in InvoiceView's shape, in the order's language
    customer    {name, email}
    withdrawal  {number, receivedAt (formatted, date and time with zone),
                 name, email, scope: all|items|part, items: list of
                 {quantity, name}, part, message}
    viewUrl     the order page, with a token; '' where the shop has none
#}
{% block subject %}{{ 'CONSHO.mail.withdrawal.subject'|trans([order.orderNumber], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
{% set label = 'padding: 2px 16px 2px 0; text-align: left; vertical-align: top; font-weight: normal; color: #555555;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.withdrawal.intro'|trans([order.orderNumber], 'contao_default') }}</p>

<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.withdrawal.statement'|trans({}, 'contao_default') }}</p>
<table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; margin: 0 0 12px 0; {{ font }}">
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.receivedAt'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;"><strong>{{ withdrawal.receivedAt }}</strong></td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.number'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ withdrawal.number }}</td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.order'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ order.orderNumber }}{% if order.orderDate %} ({{ order.orderDate }}){% endif %}</td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.name'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ withdrawal.name }}</td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.email'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ withdrawal.email }}</td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.scope'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">
        {% if withdrawal.scope == 'items' %}
            {% for item in withdrawal.items %}{{ item.quantity }} × {{ item.name }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        {% elseif withdrawal.scope == 'part' %}
            {{ withdrawal.part|nl2br }}
        {% else %}
            {{ 'CONSHO.mail.withdrawal.all'|trans({}, 'contao_default') }}
        {% endif %}
    </td></tr>
    {% if withdrawal.message %}
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.mail.withdrawal.message'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ withdrawal.message|nl2br }}</td></tr>
    {% endif %}
</table>

{# D-7, M7: the order the declaration belongs to — the version without it
   went to spam. The declaration above stays as it arrived. #}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.withdrawal.orderContext'|trans({}, 'contao_default') }}</p>
{% include '@Contao/mail/_order_context.html.twig' with {order: order, font: font} only %}

{# Optional, unlike in the other mails: a shop without an order page still
   owes the confirmation, so it goes out without the button. #}
{% if viewUrl %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>
{% endif %}

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
