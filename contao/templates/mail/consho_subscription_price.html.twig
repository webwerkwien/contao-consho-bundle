{#
  The mails of a price offer (Abo-10), to the customer, in the language of the
  order — see OrderEventMail::priceOffer().

  Loaded as @Contao/mail/consho_subscription_price.html.twig. Parameters are a
  LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order     an order of the subscription in InvoiceView's shape
    customer  {name, email}
    event     offer | decrease | reminder | accepted | lapsedBusiness | lapsedConsumer
    offer     {subscription, product, oldPrice, newPrice (formatted amounts of
              one period), priceKey (perMonth | perYear | perMonths —
              CONSHO.subscription.*), months, taxed (gross at the current
              rate; else no tax is charged), effectiveAt,
              deadlineAt (formatted days), business, answerUrl ("Meine Abos",
              or '')}
    viewUrl   the order page, with a token
#}
{% block subject %}{{ ('CONSHO.mail.priceOffer.' ~ event ~ '.subject')|trans([offer.subscription], 'contao_default') }}{% endblock %}

{% block body %}
{# Inside the block: MailRenderer renders the blocks one by one. #}
{% set old = ('CONSHO.subscription.' ~ offer.priceKey)|trans([offer.oldPrice, offer.months], 'contao_default') %}
{% set new = ('CONSHO.subscription.' ~ offer.priceKey)|trans([offer.newPrice, offer.months], 'contao_default') %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ ('CONSHO.mail.priceOffer.' ~ event ~ '.intro')|trans([offer.subscription, offer.product, offer.effectiveAt, offer.deadlineAt], 'contao_default') }}</p>

{% if event != 'lapsedConsumer' %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 8px 0; {{ font }}">
    <tr><td style="padding: 2px 16px 2px 0;">{{ 'CONSHO.mail.priceOffer.old'|trans({}, 'contao_default') }}</td><td style="padding: 2px 0;">{{ old }}</td></tr>
    <tr><td style="padding: 2px 16px 2px 0;"><strong>{{ 'CONSHO.mail.priceOffer.new'|trans([offer.effectiveAt], 'contao_default') }}</strong></td><td style="padding: 2px 0;"><strong>{{ new }}</strong></td></tr>
</table>
<p style="margin: 0 0 8px 0;"><small>{{ ('CONSHO.mail.priceOffer.' ~ (offer.taxed ? 'taxed' : 'untaxed'))|trans({}, 'contao_default') }}</small></p>
{% endif %}

{# P117, P118, P122: until when, how, and what silence means. #}
{% if event in ['offer', 'reminder'] %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.priceOffer.answer'|trans([offer.deadlineAt], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.priceOffer.decline'|trans([offer.effectiveAt], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;"><strong>{{ ('CONSHO.mail.priceOffer.' ~ (offer.business ? 'silenceBusiness' : 'silenceConsumer'))|trans([offer.deadlineAt, offer.effectiveAt], 'contao_default') }}</strong></p>
{% if offer.answerUrl %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ offer.answerUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.priceOffer.toAnswer'|trans({}, 'contao_default') }}</a>
</p>
{% endif %}
{% elseif event == 'lapsedConsumer' and offer.answerUrl %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ offer.answerUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.subscriptionReminder.renew'|trans({}, 'contao_default') }}</a>
</p>
{% endif %}

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="color: #222222;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
