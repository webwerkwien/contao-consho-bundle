{#
  A fresh link to the order page (D-6, T4), requested on the order page with
  order number and address. Always to the address of the order.

  Loaded as @Contao/mail/consho_order_link.html.twig. Parameters are a LIST
  (vsprintf).

  Variables:
    name    the name on the order; '' where none is left
    number  the order number
    link    the order page, token included
#}
{# Set inside each block: MailRenderer renders the blocks on their own. #}
{% block subject %}{{ 'CONSHO.mail.orderLink.subject'|trans([number], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{% if name %}{{ 'CONSHO.mail.salutation'|trans([name], 'contao_default') }}{% else %}{{ 'CONSHO.mail.confirmEmail.hello'|trans({}, 'contao_default') }}{% endif %}</p>
<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.orderLink.intro'|trans([number], 'contao_default') }}</p>

<p style="margin: 24px 0;">
    <a href="{{ link }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.orderLink.button'|trans({}, 'contao_default') }}</a>
</p>

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.orderLink.validity'|trans({}, 'contao_default') }}</p>
<p style="margin: 0; color: #555555;">{{ 'CONSHO.mail.orderLink.notYou'|trans({}, 'contao_default') }}</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
