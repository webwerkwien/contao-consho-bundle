{#
  A rejected withdrawal (D-3, decision F6), to the customer, in the language
  of the order. The reason is the operator's, written for this case and sent
  verbatim — Consho sets no legal wording. Escaped, with line
  breaks kept.

  Loaded as @Contao/mail/consho_withdrawal_rejected.html.twig. Parameters are
  a LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order       the order in InvoiceView's shape, in the order's language
    customer    {name, email}
    withdrawal  the withdrawal number
    reason      the operator's reason
    viewUrl     the order page, with a token; '' where the shop has none
#}
{% block subject %}{{ 'CONSHO.mail.withdrawalRejected.subject'|trans([withdrawal, order.orderNumber], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.withdrawalRejected.intro'|trans([withdrawal, order.orderNumber], 'contao_default') }}</p>
<p style="margin: 0 0 12px 0; padding: 8px 12px; border-left: 3px solid #cccccc;">{{ reason|nl2br }}</p>

{% if viewUrl %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>
{% endif %}

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
