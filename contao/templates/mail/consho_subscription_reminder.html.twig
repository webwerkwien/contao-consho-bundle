{#
  The reminder before the end of a minimum term (Abo-6, P42, P43), to the
  customer, in the language of the order. Before a renewal it is the notice
  § 6 Abs. 1 Z 2 KSchG asks for: what happens, and until when the customer can
  say no. Before an end it offers to buy again.

  Loaded as @Contao/mail/consho_subscription_reminder.html.twig. Parameters
  are a LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order         an order of the subscription in InvoiceView's shape
    customer      {name, email}
    subscription  the subscription number
    kind          ends | sameTerm | indefinite | endsNoMonthly (an open-ended rule from
                  before variant A billed otherwise than monthly: it ends)
    product       the product's name
    termEnd       the end of the minimum term, formatted
    cancelUntil   the last day a notice reaches it in time, formatted
    durationKey   year | years | month | months — CONSHO.subscription.*
    termLength    the term's number
    noticeKey     day | days — CONSHO.subscription.*
    noticeDays    the notice's number
    productUrl    the product page; '' where none could be built
    renewUrl      "Meine Abos" (Abo-7b, P71); '' where the shop names no such page
    viewUrl       the order page, with a token
#}
{% block subject %}{{ 'CONSHO.mail.subscriptionReminder.subject'|trans([subscription, termEnd], 'contao_default') }}{% endblock %}

{% block body %}
{# Inside the block: MailRenderer renders the blocks one by one. #}
{% set duration = ('CONSHO.subscription.' ~ durationKey)|trans([termLength], 'contao_default') %}
{% set notice = ('CONSHO.subscription.' ~ noticeKey)|trans([noticeDays], 'contao_default') %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionReminder.intro'|trans([subscription, product, termEnd], 'contao_default') }}</p>

<p style="margin: 0 0 8px 0;">
{%- if kind == 'sameTerm' -%}
    {{ 'CONSHO.mail.subscriptionReminder.sameTerm'|trans([duration, cancelUntil], 'contao_default') }}
{%- elseif kind == 'indefinite' -%}
    {{ 'CONSHO.mail.subscriptionReminder.indefinite'|trans([notice, termEnd, cancelUntil], 'contao_default') }}
{%- else -%}
    {{ 'CONSHO.mail.subscriptionReminder.ends'|trans([product], 'contao_default') }}
{%- endif -%}
</p>

{# Abo-7b (P71): "Meine Abos" where the shop names that page — the licence
   and its keys go on there; else the product page, to buy anew. #}
{% if kind in ['ends', 'endsNoMonthly'] and renewUrl|default('') %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ renewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.subscriptionReminder.renew'|trans({}, 'contao_default') }}</a>
</p>
{% elseif kind in ['ends', 'endsNoMonthly'] and productUrl %}
<p style="margin: 24px 0 0 0;">
    <a href="{{ productUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.subscriptionReminder.buyAgain'|trans({}, 'contao_default') }}</a>
</p>
{% endif %}

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="color: #222222;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
