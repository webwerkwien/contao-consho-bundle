{#
  "Ihre Rechnung zum Abo" (Abo-4, P30), to the customer, in the language of
  the order: the invoice of a follow-up order and the period it covers.

  No withdrawal instructions and no consent sentence — a follow-up order opens
  no withdrawal period (A12). That is why this is not the order confirmation.

  Loaded as @Contao/mail/consho_subscription_invoice.html.twig. Parameters are
  a LIST (vsprintf, see consho_payment_received.html.twig).

  Variables:
    order         the order in InvoiceView's shape, in the order's language
    customer      {name, email}
    subscription  the subscription number, "SHOP-00084-1"
    periodFrom    first day of the period, formatted
    periodUntil   end of the period, formatted
    invoice       the invoice number, attached; '' where none was issued
    charged       the day the amount was charged with the subscription's
                  mandate (Abo-4b, P97); '' for "on account"
    paymentMethod the payment method of the order
    chargeFailed  "on account" because the charge did not go through (P95, P96)
    dueDate       "on account": the due date, formatted; '' without one
    reference     "on account": the transfer reference, shown beside bank details
    viewUrl       the order page, with a token
#}
{% block subject %}{{ 'CONSHO.mail.subscriptionInvoice.subject'|trans([subscription], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionInvoice.intro'|trans([subscription, periodFrom, periodUntil], 'contao_default') }}</p>

{% include '@Contao/mail/_order_context.html.twig' with {order: order, font: font} only %}

<p style="margin: 0 0 8px 0;">{{ 'CONSHO.invoice.grandTotal'|trans({}, 'contao_default') }}: <strong>{{ order.grandTotal }}</strong></p>

{% if charged %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionInvoice.charged'|trans([charged, paymentMethod], 'contao_default') }}</p>
{% else %}
{% if chargeFailed %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionInvoice.chargeFailed'|trans({}, 'contao_default') }}</p>
{% endif %}
{% if dueDate %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionInvoice.payBy'|trans([dueDate], 'contao_default') }}</p>
{% endif %}
{# The payment block of the order confirmation (P97: "bitte bis … überweisen"). #}
{% if order.paymentInstructions or order.bankDetails is not empty %}
<div style="margin: 12px 0; padding: 12px 16px; background: #f7f7f7; border-left: 3px solid #222222;">
    {{ order.paymentInstructions|raw }}
    {% if order.bankDetails is not empty %}
    <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; {{ font }}">
        {% for key, value in order.bankDetails|filter(v => v is not empty) %}
        <tr><th scope="row" style="padding: 2px 16px 2px 0; text-align: left; font-weight: normal; color: #555555;">{{ ('CONSHO.invoice.bank.' ~ key)|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ value }}</td></tr>
        {% endfor %}
        {% if reference %}
        <tr><th scope="row" style="padding: 2px 16px 2px 0; text-align: left; font-weight: normal; color: #555555;">{{ 'CONSHO.invoice.bank.reference'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0; font-weight: bold;">{{ reference }}</td></tr>
        {% endif %}
    </table>
    {% endif %}
</div>
{% endif %}
{% endif %}

{% if invoice %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.subscriptionInvoice.invoiceAttached'|trans([invoice], 'contao_default') }}</p>
{% endif %}

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
