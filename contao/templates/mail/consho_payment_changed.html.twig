{#
  The mail after a change of payment method (C-10, 7.5 step 3), to the
  customer, in the language of the order.

  Loaded as @Contao/mail/consho_payment_changed.html.twig (the folder is part
  of the name, see consho_order_confirmation.html.twig). Parameters are a
  LIST, as there: Contao fills contao_default strings with vsprintf.

  Short on purpose: the order has not changed, only how it is paid. The
  payment block is the NEW one, from the new invoice where there is one; the
  cancellation and the new invoice travel as attachments.

  Variables:
    order      the order in InvoiceView's shape, in the order's language
    customer   {name, email}
    reference  the payment reference — the new invoice number, '' without one
    documents  {cancelledInvoice, cancellation, invoice} — numbers, '' where none
    viewUrl    the order page, with a token
#}
{% block subject %}{{ 'CONSHO.mail.paymentChanged.subject'|trans([order.orderNumber], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
{% set label = 'padding: 2px 16px 2px 0; text-align: left; font-weight: normal; color: #555555;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.paymentChanged.intro'|trans([order.orderNumber, order.paymentMethod], 'contao_default') }}</p>

{% if documents.cancellation %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.paymentChanged.cancelled'|trans([documents.cancelledInvoice, documents.cancellation], 'contao_default') }}</p>
{% endif %}
{% if documents.invoice %}
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.paymentChanged.newInvoice'|trans([documents.invoice], 'contao_default') }}</p>
{% endif %}

<table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; margin-top: 12px; {{ font }}">
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.invoice.paymentMethod'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ order.paymentMethod }}</td></tr>
    <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.invoice.grandTotal'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0; font-weight: bold;">{{ order.grandTotal }}</td></tr>
</table>

{% if order.paymentInstructions or order.bankDetails is not empty %}
<div style="margin-top: 12px; padding: 12px 16px; background: #f7f7f7; border-left: 3px solid #222222;">
    {{ order.paymentInstructions|raw }}
    {% if order.bankDetails is not empty %}
    <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; {{ font }}">
        {% for key, value in order.bankDetails|filter(v => v is not empty) %}
        <tr><th scope="row" style="{{ label }}">{{ ('CONSHO.invoice.bank.' ~ key)|trans({}, 'contao_default') }}</th><td style="padding: 2px 0;">{{ value }}</td></tr>
        {% endfor %}
        {% if reference %}
        <tr><th scope="row" style="{{ label }}">{{ 'CONSHO.invoice.bank.reference'|trans({}, 'contao_default') }}</th><td style="padding: 2px 0; font-weight: bold;">{{ reference }}</td></tr>
        {% endif %}
    </table>
    {% endif %}
</div>
{% endif %}

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
