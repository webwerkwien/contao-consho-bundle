{#
  "Ihr Gutschein" (block Wertgutscheine, WG4), to the buyer, in the language
  of the order. Sent once the vouchers of an order are issued — after the
  payment, by the release (DigitalRelease). Each voucher is attached as a PDF
  to print or pass on.

  The codes ARE in here, unlike licence keys (F20): a gift voucher is meant
  to be passed on, and this mail is how it reaches the buyer (WG4).

  Variables:
    order      the order in InvoiceView's shape, in the order's language
    customer   {name, email}
    vouchers   list of {code, value, validUntil ('' = unlimited)}
    invoice    the number of the invoice this release issued, attached; '' otherwise
    viewUrl    the order page, with a token
#}
{% block subject %}{{ 'CONSHO.mail.vouchersIssued.subject'|trans([order.orderNumber], 'contao_default') }}{% endblock %}

{% block body %}
{% set font = 'font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #222222;' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f4f4f4;">
<tr><td align="center" style="padding: 24px 12px;">
{% include '@Contao/mail/_frame_head.html.twig' %}
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background: #ffffff; {{ font }}">
<tr><td style="padding: 24px 28px;">

<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.salutation'|trans([customer.name], 'contao_default') }}</p>
<p style="margin: 0 0 12px 0;">{{ 'CONSHO.mail.vouchersIssued.intro'|trans([order.orderNumber], 'contao_default') }}</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0 0 12px 0; {{ font }}">
{% for voucher in vouchers %}
    <tr>
        <td style="padding: 8px 0; border-top: 1px solid #dddddd;"><strong>{{ voucher.value }}</strong></td>
        <td style="padding: 8px 0; border-top: 1px solid #dddddd; font-family: 'Courier New', monospace; font-size: 15px; letter-spacing: 1px;">{{ voucher.code }}</td>
        <td style="padding: 8px 0; border-top: 1px solid #dddddd; color: #555555;">{% if voucher.validUntil %}{{ 'CONSHO.voucher.validUntil'|trans([voucher.validUntil], 'contao_default') }}{% else %}{{ 'CONSHO.voucher.unlimited'|trans({}, 'contao_default') }}{% endif %}</td>
    </tr>
{% endfor %}
</table>

<p style="margin: 0 0 8px 0;">{{ 'CONSHO.mail.vouchersIssued.attached'|trans({}, 'contao_default') }}</p>
<p style="margin: 0 0 8px 0;">{{ 'CONSHO.voucher.howTo'|trans({}, 'contao_default') }}</p>

{% if invoice|default('') %}
<p style="margin: 16px 0 0 0;">{{ 'CONSHO.mail.digitalReleased.invoice'|trans([invoice], 'contao_default') }}</p>
{% endif %}

<p style="margin: 24px 0 0 0;">
    <a href="{{ viewUrl }}" style="display: inline-block; padding: 10px 18px; background: #222222; color: #ffffff; text-decoration: none; border-radius: 3px;">{{ 'CONSHO.mail.viewOrder'|trans({}, 'contao_default') }}</a>
</p>

</td></tr>
</table>
{% include '@Contao/mail/_frame_foot.html.twig' %}
</td></tr>
</table>
{% endblock %}
