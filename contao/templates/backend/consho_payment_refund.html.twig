{#
  The refund operations at a payment (block Zahlung Mollie, 4.4). Rendered
  inside the back end frame by PaymentRefundBackendController; every form
  posts back to the same address with Contao's request token.

  step: refund (the form), confirm (R5), retry, manual; correct (the form)
  and correctConfirm for a correction of a locked payment (Geldflüsse E8).
#}
<div id="tl_buttons">
    <a href="{{ back }}" class="header_back" accesskey="b">{{ lang.refundBack|default('Zurück') }}</a>
</div>

{# Contao's own HTML. #}
{{ messages|raw }}

{% set correction = step starts with 'correct' %}
{% set legend %}{{ correction ? lang.correctLegend|default('Korrektur') : lang.refundLegend|default('Erstattung') }}: {{ number }} — {{ method }}, {{ paymentLabel }}{% if paymentReference %} ({{ paymentReference }}){% endif %}{% endset %}

{% if step in ['refund', 'correct'] and refundable is null %}
    <div class="tl_formbody_edit">
        <fieldset class="tl_box">
            <legend>{{ legend }}</legend>
            <p class="tl_info">{{ correction ? lang.correctNotPossible|default('') : lang.refundNotPossible|default('') }}</p>
        </fieldset>
    </div>
{% else %}
    {# data-turbo="false": the first POST answers with the confirmation (or an
       error) instead of a redirect, and Turbo drops such an answer. #}
    <form action="{{ action }}" method="post" class="tl_form" data-turbo="false">
        <div class="tl_formbody_edit">
            <input type="hidden" name="FORM_SUBMIT" value="consho_payment_refund">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
            <fieldset class="tl_box">
                <legend>{{ legend }}</legend>
                {% if step == 'refund' %}
                    <div class="widget w50">
                        <h3><label for="ctrl_consho_amount">{{ lang.refundAmount|default('Betrag') }}</label></h3>
                        <input type="text" name="consho_amount" id="ctrl_consho_amount" class="tl_text" inputmode="decimal" value="{{ amount }}" required>
                        <p class="tl_help tl_tip">{{ lang.refundAmountHelp|default('%s')|format(refundableLabel) }}</p>
                    </div>
                    <div class="widget w50">
                        <h3><label for="ctrl_consho_reference">{{ lang.refundReference|default('Referenz') }}</label></h3>
                        <input type="text" name="consho_reference" id="ctrl_consho_reference" class="tl_text" maxlength="255" value="{{ reference }}">
                        <p class="tl_help tl_tip">{{ lang.refundReferenceHelp|default('') }}</p>
                    </div>
                    {# Geldflüsse T4: the ways; what none of them takes goes back by hand. #}
                    {% if not canProvider and foreignOffered is empty %}
                    <div class="widget clr">
                        <p class="tl_help tl_tip">{{ lang.refundWaysHandOnly|default('') }}</p>
                    </div>
                    {% else %}
                    <div class="widget clr">
                        <h3>{{ lang.refundWays|default('Wege') }}</h3>
                        <div class="tl_checkbox_container">
                            {% if canProvider %}
                                <input type="checkbox" name="consho_payout" id="ctrl_consho_payout" class="tl_checkbox" value="1"{% if payOut %} checked{% endif %}>
                                <label for="ctrl_consho_payout">{{ lang.refundWayProviderOption|default('%s')|format(method) }}</label><br>
                            {% endif %}
                            {% for event in foreignOffered %}
                                <input type="checkbox" name="consho_foreign[]" id="ctrl_consho_foreign_{{ event.id }}" class="tl_checkbox" value="{{ event.id }}"{% if event.id in foreignChosen %} checked{% endif %}>
                                <label for="ctrl_consho_foreign_{{ event.id }}">{{ lang.refundWayForeignOption|default('%s (%s)')|format(event.amountLabel, event.reference) }}</label><br>
                            {% endfor %}
                        </div>
                        <p class="tl_help tl_tip">{{ lang.refundWaysHelp|default('') }}</p>
                    </div>
                    {% endif %}
                {% elseif step == 'correct' %}
                    <div class="widget w50">
                        <h3><label for="ctrl_consho_amount">{{ lang.refundAmount|default('Betrag') }}</label></h3>
                        <input type="text" name="consho_amount" id="ctrl_consho_amount" class="tl_text" inputmode="decimal" value="{{ amount }}" required>
                        <p class="tl_help tl_tip">{{ lang.correctAmountHelp|default('%s')|format(refundableLabel) }}</p>
                    </div>
                    <div class="widget w50">
                        <h3><label for="ctrl_consho_reference">{{ lang.correctReason|default('Grund') }}</label></h3>
                        <input type="text" name="consho_reference" id="ctrl_consho_reference" class="tl_text" maxlength="255" value="{{ reference }}" required>
                        <p class="tl_help tl_tip">{{ lang.correctReasonHelp|default('') }}</p>
                    </div>
                {% elseif step == 'correctConfirm' %}
                    <input type="hidden" name="consho_amount" value="{{ amount }}">
                    <input type="hidden" name="consho_reference" value="{{ reference }}">
                    <input type="hidden" name="consho_confirmed" value="1">
                    <p class="tl_info">{{ lang.correctConfirm|default('%s / %s / %s')|format(paymentLabel, correctedLabel, reference) }}</p>
                {% elseif step == 'confirm' %}
                    <input type="hidden" name="consho_amount" value="{{ amount }}">
                    <input type="hidden" name="consho_reference" value="{{ reference }}">
                    {% if payOut %}<input type="hidden" name="consho_payout" value="1">{% endif %}
                    {% for id in foreignChosen %}<input type="hidden" name="consho_foreign[]" value="{{ id }}">{% endfor %}
                    {# The split the operator sees; booked only if it still holds. #}
                    <input type="hidden" name="consho_way_foreign" value="{{ ways.foreign }}">
                    <input type="hidden" name="consho_way_provider" value="{{ ways.provider }}">
                    <input type="hidden" name="consho_way_hand" value="{{ ways.hand }}">
                    <input type="hidden" name="consho_confirmed" value="1">
                    {% for line in confirmLines %}
                        <p class="tl_info">{{ line }}</p>
                    {% endfor %}
                {% elseif step == 'retry' %}
                    <p class="tl_info">{{ lang.refundRetryConfirm|default('%s / %s')|format(amountLabel, method) }}</p>
                {% else %}
                    <p class="tl_info">{{ lang.refundManualConfirm|default('%s / %s')|format(amountLabel, method) }}{% if payoutReference %} {{ lang.refundPayoutReference|default('%s')|format(payoutReference) }}{% endif %}</p>
                    {# Spec 9 (N3): the provider's refunds of this amount Consho
                       does not know yet; choosing one stores its ID. #}
                    {% if providerRefunds is defined and providerRefunds is not null %}
                        <div class="widget clr">
                            <h3>{{ lang.refundProviderChoice|default('') }}</h3>
                            {% if providerRefunds is empty %}
                                <p class="tl_help tl_tip">{{ lang.refundProviderNone|default('') }}</p>
                            {% else %}
                                <div class="tl_radio_container">
                                    {% for refund in providerRefunds %}
                                        <input type="radio" name="consho_provider_refund" id="ctrl_consho_provider_refund_{{ loop.index }}" class="tl_radio" value="{{ refund.reference }}">
                                        <label for="ctrl_consho_provider_refund_{{ loop.index }}">{{ refund.reference }}{% if refund.date %} — {{ refund.date }}{% endif %} ({{ attribute(lang.refundProviderStates|default({}), refund.state)|default(refund.state) }})</label><br>
                                    {% endfor %}
                                    <input type="radio" name="consho_provider_refund" id="ctrl_consho_provider_refund_0" class="tl_radio" value="" checked>
                                    <label for="ctrl_consho_provider_refund_0">{{ lang.refundProviderWithout|default('') }}</label>
                                </div>
                            {% endif %}
                        </div>
                    {% elseif step == 'manual' and not payoutReference %}
                        <p class="tl_help tl_tip">{{ lang.refundProviderUnavailable|default('') }}</p>
                    {% endif %}
                {% endif %}
            </fieldset>
        </div>
        <div class="tl_formbody_submit">
            <div class="tl_submit_container">
                <button type="submit" class="tl_submit">{{ attribute(lang, 'refundSubmit_' ~ step)|default('OK') }}</button>
            </div>
        </div>
    </form>
{% endif %}
